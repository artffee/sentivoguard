# Website — values belong in the hosting provider's sensitive env settings.
PUBLIC_ORIGIN=https://sentivoguard.com
KV_REST_API_URL=
KV_REST_API_TOKEN=
RESEND_API_KEY=
RESEND_FROM=
# Use a restricted Stripe key with customer, checkout, subscription, invoice,
# invoice-payment, charge, and billing portal permissions. Never commit keys.
STRIPE_SECRET_KEY=
SG_STRIPE_MODE=test
STRIPE_PORTAL_CONFIGURATION=
STRIPE_WEBHOOK_SECRET=
# Only Plus is offered for new purchases ($49 USD per year).
STRIPE_PRICE_PLUS=
# Optional: map existing Standard/Ultimate subscriptions during migration.
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_ULTIMATE=
SG_BILLING_ENABLED=false
SG_DOWNLOAD_URL=
# Ed25519 PEM values (literal escaped newlines accepted).
# Private key: website ONLY. Public key: website and signed desktop release.
SG_LICENSE_PRIVATE_KEY=
SG_LICENSE_PUBLIC_KEY=
# Desktop settings (never package the private key or website .env).
# Desktop origin/channel are pinned in desktop-release.json, not environment overrides.
ANTHROPIC_API_KEY=
SG_NOVA_MODEL=claude-sonnet-4-20250514
VIRUSTOTAL_API_KEY=
# SG_PORT=4173
