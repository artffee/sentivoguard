# SentivoGuard — environment variables
# Copy to .env (gitignored) and fill in. Never commit .env.

# License signing/verification secret (HS256). Mint with tools/issue-license.js
# on the same machine that has this set, then customers paste keys into Settings.
# In production, ONLY your billing backend should know this value.
SG_LICENSE_SECRET=

# Anthropic API key for Nova AI. Optional — Settings page can also set it
# at runtime, stored in ~/.sentivoguard/api-key.txt.
ANTHROPIC_API_KEY=

# VirusTotal API key. Optional — Settings page can also set it.
VIRUSTOTAL_API_KEY=

# Override the backend port (default 4173 in dev, 41730 in Electron).
# SG_PORT=4173
