# Vercel ships the marketing pages + the /api functions.
# Everything else is desktop-app source and shouldn't be uploaded.

node_modules/
dist/
build/
out/
.sentivoguard/
.git/
.gstack/
.claude/

# Desktop app source — exclude EVERYTHING in server/ except license.js
# (the API functions need to verify JWTs)
server/*
!server/license.js

# Other desktop-only directories
js/
styles/
tools/
assets/

# Top-level files used only by the desktop app
.server.js
main.js
preload.js
package-lock.json
index.html

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# Build artifacts
*.exe
*.dmg
*.blockmap

# Whitelist the gated download path — the .exe inside _dl/<random>/ ships
# but only at an unguessable URL. Only /api/download knows the URL.
!_dl/
!_dl/**
