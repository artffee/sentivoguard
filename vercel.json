{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "public": true,
  "rewrites": [
    { "source": "/",                              "destination": "/landing.html" },
    { "source": "/blog",                          "destination": "/blog.html"    },
    { "source": "/blog/real-time-disk-scanner",   "destination": "/blog-real-time-disk-scanner.html" },
    { "source": "/blog/launching-sentivoguard-21","destination": "/blog-launching-sentivoguard-21.html" },
    { "source": "/members",                       "destination": "/members.html" },
    { "source": "/members/download",              "destination": "/members-download.html" },
    { "source": "/signup",                        "destination": "/signup.html" },
    { "source": "/login",                         "destination": "/login.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",     "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(.*\\.(?:js|css|png|jpg|svg|woff2))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/_dl/(.*)\\.exe",
      "headers": [
        { "key": "Content-Type",        "value": "application/octet-stream" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"SentivoGuard-Setup-2.1.0.exe\"" },
        { "key": "Cache-Control",       "value": "private, no-store" },
        { "key": "X-Robots-Tag",        "value": "noindex, nofollow" }
      ]
    }
  ]
}
