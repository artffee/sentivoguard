{
  "name": "sentivoguard",
  "version": "2.2.0",
  "description": "SentivoGuard \u2014 Windows security companion",
  "main": "main.js",
  "author": "SentivoGuard",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "serve": "node .server.js",
    "issue-license": "node tools/issue-license.js",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:dir": "electron-builder --dir",
    "test": "node --test tests/*.test.js",
    "check": "node tools/check.js"
  },
  "build": {
    "appId": "com.sentivoguard.app",
    "productName": "SentivoGuard",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      ".server.js",
      "index.html",
      "styles/**",
      "js/**",
      "server/**",
      "assets/**",
      "package.json",
      "!server/*private*",
      "!**/.env*"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "SentivoGuard"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SentivoGuard"
    }
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "dependencies": {
    "stripe": "23.1.0"
  }
}
